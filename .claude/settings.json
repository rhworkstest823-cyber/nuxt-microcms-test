{
  "env": {
    "ANTHROPIC_MODEL": "opusplan",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run lint*)",
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run generate*)",
      "Bash(npm view *)",
      "Bash(npx oxlint *)",
      "Bash(npx eslint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx nuxt *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
